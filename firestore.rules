rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: potholes
    // Document ID: auto-generated
    // Fields:
    //   - latitude: number (required)
    //   - longitude: number (required)
    //   - reporterId: string (required)
    //   - reportedAt: timestamp (required)
    //   - severity: string (optional, enum: low, medium, high)
    //
    // Collection: fall_alerts
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - userName: string (optional)
    //   - latitude: number (required)
    //   - longitude: number (required)
    //   - timestamp: timestamp (required)
    //   - resolved: boolean (optional)
    //
    // ===============================================================
    // Document ID: userId
    // Fields:
    //   - bloodType: string (optional, enum: A+, A-, B+, B-, AB+, AB-, O+, O-)
    //   - emergencyName: string (optional)
    //   - emergencyPhone: string (optional)
    //
    // Collection: live_riders
    // Document ID: userId
    // Fields:
    //   - userId: string (required)
    //   - userName: string (optional)
    //   - userPhoto: string (optional)
    //   - status: string (required, enum: ready, riding)
    //   - lastSeen: timestamp (required)
    //
    // Collection: safe_zones
    // Document ID: auto-generated
    // Fields:
    //   - latitude: number (required)
    //   - longitude: number (required)
    //   - title: string (required)
    //   - reporterId: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: group_rides
    // Document ID: auto-generated
    // Fields:
    //   - creatorId: string (required)
    //   - title: string (required)
    //   - active: boolean (required)
    //   - members: map (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
       return request.auth != null;
    }

    function isOwner(userId) {
       return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "jaymiller0202@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidPothole(data) {
      return data.latitude is number && 
             data.longitude is number &&
             data.reporterId is string &&
             data.reportedAt is timestamp &&
             (!('severity' in data) || data.severity in ['low', 'medium', 'high']);
    }

    function isValidPrivateData(data) {
      return (!('bloodType' in data) || data.bloodType in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']) &&
             (!('emergencyName' in data) || (data.emergencyName is string && data.emergencyName.size() < 100)) &&
             (!('emergencyPhone' in data) || (data.emergencyPhone is string && data.emergencyPhone.size() < 20));
    }

    function isValidFallAlert(data) {
      return data.userId is string &&
             data.latitude is number &&
             data.longitude is number &&
             data.timestamp is timestamp &&
             (!('resolved' in data) || data.resolved is bool);
    }

    function isValidLiveRider(data) {
      return data.userId is string &&
             data.status in ['ready', 'riding'] &&
             data.lastSeen is timestamp;
    }

    function isValidSafeZone(data) {
      return data.latitude is number && 
             data.longitude is number &&
             data.title is string &&
             data.reporterId is string;
    }

    function isValidGroupRide(data) {
      return data.creatorId is string &&
             data.title is string &&
             data.active is bool &&
             data.members is map;
    }

    function isValidUserPublic(data) {
      return data.userId is string &&
             data.userName is string &&
             (!('pacePreference' in data) || data.pacePreference in ['cruising', 'balanced', 'speed']) &&
             (!('skateStyle' in data) || data.skateStyle in ['street', 'long-distance', 'freestyle']);
    }

    function isValidChatMessage(data) {
      return data.channelId is string &&
             data.senderId is string &&
             data.text is string &&
             data.text.size() < 1000 &&
             data.timestamp is timestamp;
    }

    function isValidRideRecap(data) {
      return data.creatorId is string &&
             data.distance is number &&
             data.timestamp is timestamp;
    }

    function isValidRideStreak(data) {
      return data.userId is string &&
             data.currentStreak is number &&
             (!('totalRides' in data) || data.totalRides is number);
    }

    function isValidGearItem(data) {
      return data.ownerId is string &&
             data.itemName is string && data.itemName.size() > 0 &&
             data.itemType in ['board', 'helmet', 'pad', 'tool', 'other'] &&
             data.status in ['available', 'lent', 'unavailable'];
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /potholes/{potholeId} {
      // Anyone authenticated can read potholes (needed for warnings)
      allow read: if isAuthenticated();
      
      // Anyone authenticated can create a pothole report
      allow create: if isAuthenticated() && 
                ;ó¯<¶‰žËkºwµçbW†—C×·²÷6—G“¢×ÐÐ¢6Æ74æÖSÒ&f—†VB–ç6WBÓ¢ÓS&rÖ&Æ6²ó“R&6¶G&÷Ö&ÇW"×6ÒfÆW‚—FV×2Ö6VçFW"§W7F–g’Ö6VçFW"Ób Ð¢àÐ¢ÆÖ÷F–öâæF—`Ð¢–æ—F–Ã×·²66ÆS¢ã’Â“¢#×ÐÐ¢æ–ÖFS×·²66ÆS¢Â“¢×ÐÐ¢6Æ74æÖSÒ&&rÕ²3Ò&÷&FW"&÷&FW"Õ²3##%Ò&÷VæFVBÕ³3'…ÒrÖgVÆÂÖ‚×rÖÖB÷fW&fÆ÷rÖ†–FFVâ&VÆF—fR Ð¢àÐ¢ÆF—b6Æ74æÖSÒ'Ó‚"ÓB#àÐ¢ÄÆ&VÂ6Æ74æÖSÒ'FW‡BÕ²4dcd#Ò#å6fWG’&÷Fö6öÃÂôÆ&VÃàÐ¢Æƒ"6Æ74æÖSÒ'FW‡BÓG†ÂföçBÖ&Æ6²G&6¶–ær×F–v‡FW"Ö"Ó"—FÆ–2#àÐ¢$ô$BÔ4„T4²òðÐ¢Âöƒ#àÐ¢Ç6Æ74æÖSÒ'FW‡BÕ³…ÒWW&66RföçBÖ&öÆBFW‡BÕ²3cceÒG&6¶–ærÕ³'…ÒÖ"Ó‚#àÐ¢fW&–f–6F–öâ&WV—&VBFòVævvRÖ÷F÷'0Ð¢Â÷àÐ Ð¢ÆF—b6Æ74æÖSÒ'76R×’Ó2Ö"Ó#àÐ¢´$ô$Eô4„T4´Ä•5BæÖ‚†—FVÒ’Óâ°Ð¢6öç7B–6öâÒ—FVÒæ–6öã°Ð¢6öç7B—46†V6¶VBÒ6†V6¶VD—FV×2æ†2†—FVÒæ–B“°Ð¢&WGW&â€Ð¢Æ'WGFöàÐ¢¶W“×¶—FVÒæ–GÐÐ¢öä6Æ–6³×²‚’ÓâFövvÆT6†V6¶Æ—7D—FVÒ†—FVÒæ–B—ÐÐ¢6Æ74æÖS×¶rÖgVÆÂÓR&÷VæFVBÓ'†ÂfÆW‚—FV×2Ö6VçFW"§W7F–g’Ö&WGvVVâG&ç6—F–öâÖÆÂ&÷&FW"G¶—46†V6¶VBò&&rÕ²4dcd#ÒóR&÷&FW"Õ²4dcd#Òó#FW‡B×v†—FR"¢&&rÕ²3SSUÒ&÷&FW"×G&ç7&VçBFW‡BÕ²3cceÒ'ÖÐÐ¢àÐ¢ÆF—b6Æ74æÖSÒ&fÆW‚—FV×2Ö6VçFW"vÓB#àÐ¢ÆF—`Ð¢6Æ74æÖS×¶G¶—46†V6¶VBò'FW‡BÕ²4dcd#Ò"¢'FW‡BÖ–æ†W&—B'ÖÐÐ¢àÐ¢Ä–6öâ6—¦S×³#ÒóàÐ¢ÂöF—càÐ¢Ç7â6Æ74æÖSÒ'FW‡B×6ÒföçBÖ&öÆBWW&66RG&6¶–ær×F–v‡B#àÐ¢¶—FV